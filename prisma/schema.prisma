generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id               String            @id @default(cuid())
  supabaseUserId   String            @unique
  email            String            @unique
  displayName      String
  publications     Publication[]
  adoptionRequests AdoptionRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum PublicationAgeUnit {
  DAYS
  MONTHS
  YEARS
}

enum PublicationSex {
  MALE
  FEMALE
}

enum PublicationSpecies {
  CAT
  DOG
}

enum PublicationStatus {
  ACTIVE
  ADOPTED
  DRAFT
}

model Publication {
  id              String             @id @default(cuid())
  authorProfileId String
  authorProfile   Profile            @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)
  slug            String             @unique
  petName         String
  ageValue        Int
  ageUnit         PublicationAgeUnit
  sex             PublicationSex
  species         PublicationSpecies @default(CAT)
  location        String
  characteristics String[]           @default([])
  description     String             @db.Text
  rescueInstagram String?
  imageUrl        String?
  status          PublicationStatus   @default(ACTIVE)
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  adoptionRequests AdoptionRequest[]

  @@index([authorProfileId, status, createdAt])
  @@index([status, createdAt])
}

enum AdoptionRequestStatus {
  PENDING
  SCHEDULED
  APPROVED
  REJECTED
}

model AdoptionRequest {
  id             String      @id @default(cuid())
  publicationId  String
  publication    Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  ownerProfileId String
  ownerProfile   Profile     @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)

  // Paso 1 — datos del adoptante
  firstName        String
  lastName         String
  email            String
  phone            String
  domicilio        String
  barrio           String
  preferredContact String

  // Paso 2 — hogar
  housingType String
  protection  String
  otherPets   String?

  // Paso 3 — sobre la mascota
  reason           String @db.Text
  aloneHoursPerDay String

  status           AdoptionRequestStatus @default(PENDING)
  visitScheduledAt DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([ownerProfileId, status, createdAt])
  @@index([publicationId])
}